{
  "name": "nekofin",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "scripts": {
    "start": "expo start",
    "start:dev": "APP_VARIANT=development expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:dev": "APP_VARIANT=development expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ios:stroke-text": "bash modules/stroke-text/tests/run-ios-tests.sh",
    "test:ios:player-scrubber": "bash modules/player-scrubber/tests/run-ios-tests.sh",
    "test:ios:player-scrubber-ui": "bash modules/player-scrubber/tests/run-ios-ui-tests.sh",
    "test:smoke": "vitest run smoke",
    "test:watch": "vitest",
    "test:ota": "node --test scripts/ota/*.test.mjs updates/server/lib/*.test.mjs",
    "lint": "lint-staged",
    "prepare": "husky",
    "lint:commit": "commitlint --edit"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.12",
    "@expo/ui": "~55.0.17",
    "@expo/vector-icons": "^15.0.3",
    "@jellyfin/sdk": "^0.13.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-menu/menu": "2.0.0",
    "@tanstack/query-async-storage-persister": "^5.101.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-persist-client": "^5.101.0",
    "axios": "^1.17.0",
    "burnt": "^0.13.0",
    "dayjs": "^1.11.23",
    "expo": "~55.0.32",
    "expo-application": "~55.0.19",
    "expo-blur": "~55.0.18",
    "expo-brightness": "~55.0.17",
    "expo-build-properties": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.41",
    "expo-device": "~55.0.21",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-glass-effect": "~55.0.11",
    "expo-haptics": "~55.0.18",
    "expo-image": "~55.0.11",
    "expo-keep-awake": "~55.0.8",
    "expo-linear-gradient": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-localization": "~55.0.19",
    "expo-mpv": "0.1.27",
    "expo-navigation-bar": "~55.0.17",
    "expo-network": "~55.0.18",
    "expo-router": "~55.0.18",
    "expo-screen-orientation": "~55.0.20",
    "expo-sharing": "~55.0.25",
    "expo-splash-screen": "~55.0.25",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.22",
    "expo-updates": "~55.0.33",
    "expo-web-browser": "~55.0.20",
    "i18next": "^26.5.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^17.1.2",
    "react-native": "0.83.10",
    "react-native-drawer-layout": "^4.2.4",
    "react-native-easing-gradient": "^1.1.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-ios-context-menu": "^3.2.1",
    "react-native-ios-utilities": "^5.2.0",
    "react-native-mmkv": "^3.3.1",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-performance-toolkit": "^0.3.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "4.25.2",
    "react-native-uuid": "^2.0.3",
    "react-native-video": "^6.19.2",
    "react-native-volume-manager": "^2.0.8",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "semver": "^7.8.5",
    "sonner": "^2.0.8",
    "zeego": "^3.0.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.5.1",
    "@types/node": "~24.19.2",
    "@types/react": "~19.2.16",
    "@types/react-dom": "~19.2.0",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.1",
    "eslint-plugin-react-hooks": "^7.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.4",
    "prettier": "3.6.2",
    "tsx": "^4.22.4",
    "typescript": "~5.9.2",
    "vitest": "^4.1.8"
  },
  "private": true,
  "packageManager": "bun@1.2.21",
  "overrides": {
    "expo-constants": "~55.0.17"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-screens"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    },
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-ui"
        ]
      }
    }
  },
  "reanimated": {
    "staticFeatureFlags": {
      "DISABLE_COMMIT_PAUSING_MECHANISM": true
    }
  },
  "patchedDependencies": {
    "react-native-ios-utilities@5.2.0": "patches/react-native-ios-utilities@5.2.0.patch",
    "react-native-ios-context-menu@3.2.1": "patches/react-native-ios-context-menu@3.2.1.patch",
    "expo-linear-gradient@55.0.18": "patches/expo-linear-gradient@55.0.18.patch",
    "react-native-screens@4.25.2": "patches/react-native-screens@4.25.2.patch",
    "expo-mpv@0.1.27": "patches/expo-mpv@0.1.27.patch",
    "react-native-reanimated@4.2.1": "patches/react-native-reanimated@4.2.1.patch",
    "expo-router@55.0.18": "patches/expo-router@55.0.18.patch",
    "react-native@0.83.10": "patches/react-native@0.83.10.patch",
    "@expo/ui@55.0.17": "patches/@expo%2Fui@55.0.17.patch"
  }
}
