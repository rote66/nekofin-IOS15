+// An unknown Fabric handle must never be mounted with UnimplementedView's
+// updateProps implementation: it assumes UnimplementedViewProps, whereas the
+// mounted node can contain a completely different, incompatible props class.
+// Keep the view hierarchy intact until the provider is registered, without
+// interpreting foreign props or creating a fake red error label.
+@interface RCTMissingComponentView : RCTViewComponentView
+@end
+
+@implementation RCTMissingComponentView
+- (void)updateProps:(const Props::Shared &)props oldProps:(const Props::Shared &)oldProps
+{
+  // Intentionally do not cast or forward arbitrary native component props.
+}
+@end
